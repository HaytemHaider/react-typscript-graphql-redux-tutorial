{
  "name": "mini-systems-frontend-refresher",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run --exclude 'exercises/**'",
    "test:watch": "vitest --exclude 'exercises/**'",
    "test:level": "vitest run",
    "test:01": "vitest run exercises/level-01",
    "test:02": "vitest run exercises/level-02",
    "test:03": "vitest run exercises/level-03",
    "test:04": "vitest run exercises/level-04",
    "test:05": "vitest run exercises/level-05",
    "test:06": "vitest run exercises/level-06",
    "test:07": "vitest run exercises/level-07",
    "test:08": "vitest run exercises/level-08",
    "test:09": "vitest run exercises/level-09",
    "test:10": "vitest run exercises/level-10",
    "test:solutions": "vitest run solutions",
    "typecheck": "tsc -b",
    "lint": "eslint ."
  },
  "dependencies": {
    "@apollo/client": "^4.0.4",
    "@fluentui/react-components": "^9.72.3",
    "@reduxjs/toolkit": "^2.9.0",
    "graphql": "^16.11.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
